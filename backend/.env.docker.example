# Example Docker environment configuration for Screen2Deck backend.
#
# 1. Copy to backend/.env.docker (gitignored).
# 2. Replace every <placeholder> below with a real value from your
#    secret manager (1Password, AWS SM, Vault, ESO, etc.).
# 3. NEVER commit the resulting file. NEVER check this example back in
#    with literal defaults — the CI guard in .github/workflows/
#    security-checks.yml will fail the build on known-bad strings.

# Database configuration
# POSTGRES_PASSWORD is injected by docker-compose.yml from the shell
# environment. Build the URL inline to avoid persisting credentials
# here in plain text.
DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@postgres:5432/screen2deck

# Redis configuration
REDIS_URL=redis://redis:6379/0

# Security — REQUIRED.
# Generate with: openssl rand -base64 48
JWT_SECRET_KEY=<generate-me-via-openssl-rand>

# OCR configuration
OCR_MIN_CONF=0.62
ALWAYS_VERIFY_SCRYFALL=true

# Telemetry configuration
FEATURE_TELEMETRY=false
OTEL_SDK_DISABLED=true