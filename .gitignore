# Scryfall bulk data is runtime-generated by scripts/download_scryfall.py
# and then hydrated into scryfall_cache.sqlite on container start. Both
# are large (~500 MB each) and must NOT be committed — previously
# scryfall_cache.sqlite was tracked and caused "attempt to write a
# readonly database" on the CI `core` job because the bind-mounted
# read-only git checkout collided with sqlite's write locking.
backend/app/data/scryfall-default-cards.json
backend/app/data/scryfall_cache.sqlite
backend/app/data/*.sqlite-shm
backend/app/data/*.sqlite-wal